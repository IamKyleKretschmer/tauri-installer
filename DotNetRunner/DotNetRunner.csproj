<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>DotNetRunner</RootNamespace>
    <AssemblyName>DotNetRunner</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.DirectoryServices.AccountManagement" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces the in-box System.Data.SqlClient: it only understands
         classic on-prem Windows/Kerberos auth, with no concept of Azure
         AD/Entra identities, which is what "Windows authentication" means
         on an Entra-joined machine. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

</Project>
